# Copy this file to .env.local and fill in the mailbox that should receive inquiries.
# Port 465 uses implicit TLS. Other ports, including 587, use STARTTLS.
# SMTP_FROM can be a bare address. The name in content/site.json is used as the display name.
# A full value such as "Studio Name <you@example.com>" is used as written.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=you@example.com
CONTACT_TO=you@example.com
